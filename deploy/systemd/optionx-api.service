[Unit]
Description=OptionX FastAPI backend
After=network-online.target
Wants=network-online.target
PartOf=optionx.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/optionx/backend
EnvironmentFile=/home/ubuntu/optionx/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/optionx/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000 --workers 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=optionx.target
